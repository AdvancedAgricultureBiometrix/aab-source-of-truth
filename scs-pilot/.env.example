# SCS pilot — environment variables
#
# Copy to .env for local development:   cp .env.example .env
# .env is git-ignored. Never commit real credentials. Every value below is a
# placeholder; replace each "change-me" before starting the stack.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Database created on first start of the postgres container.
POSTGRES_DB=scs_pilot
# Owner role created on first start. Owns the database and runs migrations.
# Never used by the api.
POSTGRES_USER=scs_owner
POSTGRES_PASSWORD=change-me
# Host port the database is published on (bound to 127.0.0.1 only).
POSTGRES_PORT=5432

# Password for scs_api, the restricted role the api connects as (created by
# migration 004 without a password; set on every start by the migrate service,
# after migrations). migrate fails, and the api does not start, if it is empty,
# still starts with change-me, is shorter than 16 characters, or equals
# POSTGRES_PASSWORD.
SCS_API_DB_PASSWORD=change-me-scs-api-password

# ── MinIO (S3-compatible object storage) ─────────────────────────────────────
# The evidence object store (SCS-PLATFORM-01): evidence files are stored here
# under their SHA-256. TODO(object-store-credentials): the api uses the root
# credentials in the pilot; production needs a put/head-only user.
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
# Host ports for the S3 API and the web console (bound to 127.0.0.1 only).
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Bucket for evidence objects; the api creates it at startup if missing.
S3_BUCKET=scs-evidence

# ── API ──────────────────────────────────────────────────────────────────────
# Port the HTTP server listens on (inside the container and on the host).
API_PORT=3000

# Static bearer-token actors for the pilot (packages/api/config/static-actors.json,
# git-ignored; copy static-actors.example.json and replace every tokenSha256 with
# the SHA-256 of a random token of at least 32 characters). Set automatically
# for the api container; only needed when running the api on the host.
# SCS_AUTH_STATIC_ACTORS_FILE=./config/static-actors.json

# Database connection for the api. Set automatically for the api container by
# docker-compose.yml; only needed when running the api directly on the host
# (npm run dev in packages/api). Always scs_api — never the owner.
# SCS_DB_HOST=127.0.0.1
# SCS_DB_PORT=5432
# SCS_DB_NAME=scs_pilot
# SCS_DB_USER=scs_api
# SCS_DB_PASSWORD=change-me-scs-api-password
# Optional pool tuning (defaults shown):
# SCS_DB_POOL_MAX=10
# SCS_DB_IDLE_TIMEOUT_MS=30000
# SCS_DB_CONNECTION_TIMEOUT_MS=5000
# SCS_DB_STATEMENT_TIMEOUT_MS=15000
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_ACCESS_KEY_ID=change-me
# S3_SECRET_ACCESS_KEY=change-me-at-least-8-chars

# ── Tests ────────────────────────────────────────────────────────────────────
# Integration tests (npm test) — a superuser connection on a DISPOSABLE
# PostgreSQL instance. The tests create and drop their own temporary
# databases and roles there; never point this at a real database.
# SCS_TEST_ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# Evidence object store tests — a DISPOSABLE S3-compatible store (MinIO). The
# tests create and remove their own bucket.
# SCS_TEST_S3_ENDPOINT=http://127.0.0.1:9000
# SCS_TEST_S3_ACCESS_KEY_ID=change-me
# SCS_TEST_S3_SECRET_ACCESS_KEY=change-me-at-least-8-chars
