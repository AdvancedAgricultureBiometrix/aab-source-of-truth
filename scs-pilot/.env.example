# SCS pilot — environment variables
#
# Copy to .env for local development:   cp .env.example .env
# .env is git-ignored. Never commit real credentials. Every value below is a
# placeholder; replace each "change-me" before starting the stack.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Database created on first start of the postgres container.
POSTGRES_DB=scs_pilot
# Owner role created on first start. Also used by the api for now —
# see TODO(roles) in docker-compose.yml.
POSTGRES_USER=scs_owner
POSTGRES_PASSWORD=change-me
# Host port the database is published on (bound to 127.0.0.1 only).
POSTGRES_PORT=5432

# ── MinIO (S3-compatible object storage) ─────────────────────────────────────
# Not used by any code yet — reserved for evidence object storage.
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
# Host ports for the S3 API and the web console (bound to 127.0.0.1 only).
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Bucket the api will use for evidence objects once storage is implemented.
S3_BUCKET=scs-evidence

# ── API ──────────────────────────────────────────────────────────────────────
# Port the HTTP server listens on (inside the container and on the host).
API_PORT=3000

# Set automatically for the api container by docker-compose.yml; only needed
# when running the api directly on the host (npm run dev in packages/api):
# DATABASE_URL=postgres://scs_owner:change-me@127.0.0.1:5432/scs_pilot
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_ACCESS_KEY_ID=change-me
# S3_SECRET_ACCESS_KEY=change-me-at-least-8-chars
