# SCS pilot — environment variables
#
# Copy to .env for local development:   cp .env.example .env
# .env is git-ignored. Never commit real credentials. Every value below is a
# placeholder; replace each "change-me" before starting the stack.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Database created on first start of the postgres container.
POSTGRES_DB=scs_pilot
# Owner role created on first start. Owns the database and runs migrations.
# Never used by the api.
POSTGRES_USER=scs_owner
POSTGRES_PASSWORD=change-me
# Host port for the database (127.0.0.1 only), forwarded by the edge container
# only with docker-compose.dev.yml (for the tests); not published otherwise.
POSTGRES_PORT=5432

# Password for scs_api, the restricted role the api connects as (created by
# migration 004 without a password; set on every start by the migrate service,
# after migrations). migrate fails, and the api does not start, if it is empty,
# still starts with change-me, is shorter than 16 characters, or equals
# POSTGRES_PASSWORD.
SCS_API_DB_PASSWORD=change-me-scs-api-password

# ── SeaweedFS (S3-compatible object storage) ─────────────────────────────────
# The evidence object store (AAB-PLATFORM-01): evidence files are stored here
# under their SHA-256, in a bucket locked with Object Lock (GOVERNANCE mode,
# 2,192 days). Three identities, each with its own credential (amendment of
# 2026-09-28, section 1):
#   admin   everything; given only to seaweedfs and the objectstore-init setup
#           step, never to the api
#   api     read and write on the evidence bucket only; a bucket policy (set
#           by objectstore-init) removes every delete and every lock,
#           retention and policy change
#   backup  read and list only; used by backup/backup.mjs to export the store
# seaweedfs refuses to start if a value is missing or a change-me placeholder,
# if a secret is shorter than 16 characters, if two identities share a key or
# a secret, or if a value uses a character outside [A-Za-z0-9._~+/=-].
S3_ADMIN_ACCESS_KEY_ID=change-me-admin
S3_ADMIN_SECRET_ACCESS_KEY=change-me-admin-secret
S3_API_ACCESS_KEY_ID=change-me-api
S3_API_SECRET_ACCESS_KEY=change-me-api-secret
S3_BACKUP_ACCESS_KEY_ID=change-me-backup
S3_BACKUP_SECRET_ACCESS_KEY=change-me-backup-secret
# The override credential, which alone may override the lock to erase an
# object where the law requires it, is NEVER set here and never configured in
# the store in normal operation: it is held by its custodian (AAB-PLATFORM-01,
# section 4). seaweedfs refuses to start if S3_OVERRIDE_ACCESS_KEY_ID or
# S3_OVERRIDE_SECRET_ACCESS_KEY is set.
# Host port for the S3 API (127.0.0.1 only), forwarded by the edge container
# only with docker-compose.dev.yml (for the tests); not published otherwise.
S3_PORT=9000
# Bucket for evidence objects. Created, locked and given its policy by the
# objectstore-init setup step, never by the api. Must not start with scs-idt-,
# the test identities' prefix.
S3_BUCKET=scs-evidence

# ── API ──────────────────────────────────────────────────────────────────────
# Host port for the API (127.0.0.1 only), published by the edge container. Inside
# the stack's internal network the API always listens on 3000.
API_PORT=3000

# Static bearer-token actors for the pilot (packages/api/config/static-actors.json,
# git-ignored; copy static-actors.example.json and replace every tokenSha256 with
# the SHA-256 of a random token of at least 32 characters). Set automatically
# for the api container; only needed when running the api on the host.
# SCS_AUTH_STATIC_ACTORS_FILE=./config/static-actors.json

# The country tenancy that issues the pilot's actors (AAB-PLATFORM-03): every
# ActorReference the API records names it as its issuer. ISO 3166-1 alpha-2.
# Required; there is no default.
SCS_ACTOR_ISSUER_COUNTRY=TH

# Database connection for the api. Set automatically for the api container by
# docker-compose.yml; only needed when running the api directly on the host
# (npm run dev in packages/api). Always scs_api — never the owner.
# SCS_DB_HOST=127.0.0.1
# SCS_DB_PORT=5432
# SCS_DB_NAME=scs_pilot
# SCS_DB_USER=scs_api
# SCS_DB_PASSWORD=change-me-scs-api-password
# Optional pool tuning (defaults shown):
# SCS_DB_POOL_MAX=10
# SCS_DB_IDLE_TIMEOUT_MS=30000
# SCS_DB_CONNECTION_TIMEOUT_MS=5000
# SCS_DB_STATEMENT_TIMEOUT_MS=15000
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_API_ACCESS_KEY_ID=change-me-api
# S3_API_SECRET_ACCESS_KEY=change-me-api-secret

# ── Tests ────────────────────────────────────────────────────────────────────
# Integration tests (npm test) — a superuser connection on a DISPOSABLE
# PostgreSQL instance. The tests create and drop their own temporary
# databases and roles there; never point this at a real database.
# SCS_TEST_ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# Evidence object store tests — a DISPOSABLE S3-compatible store (SeaweedFS). The
# tests create and remove their own buckets. The admin credential:
# SCS_TEST_S3_ENDPOINT=http://127.0.0.1:9000
# SCS_TEST_S3_ACCESS_KEY_ID=change-me-admin
# SCS_TEST_S3_SECRET_ACCESS_KEY=change-me-admin-secret
# The scoped-store tests (object-store-identities, -setup, -startup) also need
# two test identities scoped to scs-idt-* buckets. With docker-compose.dev.yml,
# setting these adds them to the stack's store (they never reach the country
# stack); the identity name is scs-test-api:
# SCS_TEST_S3_API_ACCESS_KEY_ID=change-me-test-api
# SCS_TEST_S3_API_SECRET_ACCESS_KEY=change-me-test-api-secret
# SCS_TEST_S3_API_IDENTITY=scs-test-api
# SCS_TEST_S3_BACKUP_ACCESS_KEY_ID=change-me-test-backup
# SCS_TEST_S3_BACKUP_SECRET_ACCESS_KEY=change-me-test-backup-secret
