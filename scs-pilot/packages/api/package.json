{
  "name": "@aab/scs-pilot-api",
  "version": "0.0.0",
  "private": true,
  "description": "SCS pilot API — scaffold only. Health check endpoint; no capability logic.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "generate:types": "node scripts/generate-types.mjs",
    "migrate": "tsx src/migrations/cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fontkit": "2.0.4",
    "pdfkit": "0.20.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "json-schema-to-typescript": "^16.0.0",
    "pdfjs-dist": "6.3.289",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
