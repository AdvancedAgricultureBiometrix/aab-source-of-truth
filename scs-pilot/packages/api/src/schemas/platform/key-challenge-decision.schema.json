{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aab:schema:platform:key-challenge-decision:1",
  "title": "KeyChallengeDecision",
  "description": "AAB-PLATFORM-09 section 3: a registration challenge issued.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decisionId",
    "decision",
    "challengeId",
    "keyId",
    "purpose",
    "issuer",
    "actorId",
    "nonce",
    "issuedAt",
    "expiresAt",
    "decisionReasons",
    "decidedBy",
    "decidedAt"
  ],
  "properties": {
    "decisionId": {
      "type": "string",
      "format": "uuid"
    },
    "decision": {
      "type": "string",
      "const": "ISSUED"
    },
    "challengeId": {
      "type": "string",
      "format": "uuid"
    },
    "keyId": {
      "type": "string",
      "format": "uuid"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "BOOTSTRAP",
        "REGISTRATION"
      ]
    },
    "issuer": {
      "$ref": "urn:aab:schema:platform:key-registry-issuer:1"
    },
    "actorId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "decisionReasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decidedBy": {
      "$ref": "urn:aab:scs:schema:shared:actor-reference:1"
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
