{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aab:schema:platform:key-event-decision:1",
  "title": "KeyEventDecision",
  "description": "AAB-PLATFORM-09 section 4: a key event recorded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decisionId",
    "decision",
    "eventId",
    "keyId",
    "eventType",
    "effectiveAt",
    "resultingState",
    "eventDigest",
    "signatureAcceptance",
    "decisionReasons",
    "decidedBy",
    "decidedAt"
  ],
  "properties": {
    "decisionId": {
      "type": "string",
      "format": "uuid"
    },
    "decision": {
      "type": "string",
      "const": "RECORDED"
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "keyId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "enum": [
        "SUSPENDED",
        "REINSTATED",
        "RETIRED"
      ]
    },
    "effectiveAt": {
      "type": "string",
      "format": "date-time"
    },
    "resultingState": {
      "type": "string",
      "enum": [
        "PENDING",
        "ACTIVE",
        "SUSPENDED",
        "RETIRED"
      ]
    },
    "eventDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signatureAcceptance": {
      "$ref": "urn:aab:schema:platform:key-signature-acceptance:1"
    },
    "decisionReasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decidedBy": {
      "$ref": "urn:aab:scs:schema:shared:actor-reference:1"
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
