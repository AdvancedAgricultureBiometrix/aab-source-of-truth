{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aab:schema:platform:key-compromise-response:1",
  "title": "KeyCompromiseResponse",
  "description": "Body of a successful POST /aab/v1/signing-keys/:keyId/compromises (201): the decision, its immutable receipt, and the receipt's SHA-256 over canonical JSON.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "receipt",
    "receiptDigest"
  ],
  "properties": {
    "decision": {
      "$ref": "urn:aab:schema:platform:key-compromise-decision:1"
    },
    "receipt": {
      "$ref": "urn:aab:schema:platform:key-compromise-receipt:1"
    },
    "receiptDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
