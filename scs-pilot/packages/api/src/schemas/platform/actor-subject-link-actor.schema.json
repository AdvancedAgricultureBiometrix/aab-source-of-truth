{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aab:scs:schema:platform:actor-subject-link-actor:1",
  "title": "ActorSubjectLinkActor",
  "description": "AAB-PLATFORM-04: an actor as a link names it, the pair (issuer, actorId) of AAB-PLATFORM-03. Used for the linked actor, a link's creator and a status record's writer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issuer",
    "actorId"
  ],
  "properties": {
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuerType"
      ],
      "properties": {
        "issuerType": {
          "type": "string",
          "enum": [
            "PLATFORM_CONTROL_PLANE",
            "COUNTRY_TENANCY"
          ]
        },
        "countryCode": {
          "description": "ISO 3166-1 alpha-2. Required for COUNTRY_TENANCY, absent for PLATFORM_CONTROL_PLANE.",
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        }
      },
      "if": {
        "properties": {
          "issuerType": {
            "const": "COUNTRY_TENANCY"
          }
        }
      },
      "then": {
        "properties": {
          "countryCode": true
        },
        "required": [
          "countryCode"
        ]
      },
      "else": {
        "properties": {
          "countryCode": false
        }
      }
    },
    "actorId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
    }
  }
}
