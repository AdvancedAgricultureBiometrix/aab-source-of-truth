{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aab:schema:platform:key-registration-decision:1",
  "title": "KeyRegistrationDecision",
  "description": "AAB-PLATFORM-09 section 3: a key registered by a registration authority who is not its holder.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decisionId",
    "decision",
    "keyId",
    "issuer",
    "actorId",
    "publicKeyDigest",
    "activeFrom",
    "registrationDigest",
    "signatureAcceptance",
    "decisionReasons",
    "decidedBy",
    "decidedAt"
  ],
  "properties": {
    "decisionId": {
      "type": "string",
      "format": "uuid"
    },
    "decision": {
      "type": "string",
      "const": "REGISTERED"
    },
    "keyId": {
      "type": "string",
      "format": "uuid"
    },
    "issuer": {
      "$ref": "urn:aab:schema:platform:key-registry-issuer:1"
    },
    "actorId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
    },
    "publicKeyDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "activeFrom": {
      "type": "string",
      "format": "date-time"
    },
    "replacesKeyId": {
      "type": "string",
      "format": "uuid"
    },
    "registrationDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signatureAcceptance": {
      "$ref": "urn:aab:schema:platform:key-signature-acceptance:1"
    },
    "decisionReasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decidedBy": {
      "$ref": "urn:aab:scs:schema:shared:actor-reference:1"
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
