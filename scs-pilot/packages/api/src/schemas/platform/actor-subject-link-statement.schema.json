{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aab:scs:schema:platform:actor-subject-link-statement:1",
  "title": "ActorSubjectLinkStatement",
  "description": "AAB-PLATFORM-04 ActorSubjectLinkStatement: what a link's creator decides, and signs, before submitting. Every field is known before submission. The signed bytes are its canonical JSON.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "statementType",
    "actor",
    "subject",
    "relation",
    "validFrom",
    "validUntil",
    "authorisationEvidence",
    "creator"
  ],
  "properties": {
    "statementType": {
      "const": "ACTOR_SUBJECT_LINK"
    },
    "actor": {
      "$ref": "urn:aab:scs:schema:platform:actor-subject-link-actor:1"
    },
    "subject": {
      "$ref": "urn:aab:scs:schema:platform:subject-key:1"
    },
    "relation": {
      "type": "string",
      "enum": [
        "IS_SUBJECT",
        "ACTS_FOR_SUBJECT"
      ]
    },
    "validFrom": {
      "type": "string",
      "format": "date-time"
    },
    "validUntil": {
      "type": "string",
      "format": "date-time"
    },
    "authorisationEvidence": {
      "description": "Evidence that the subject authorised the relationship: at least one AAB-PLATFORM-01 stored object.",
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidenceObjectSha256",
          "description"
        ],
        "properties": {
          "evidenceObjectSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "The AAB-PLATFORM-01 objectId: lowercase hex SHA-256 of the stored bytes."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "\\S"
          }
        }
      }
    },
    "supersedesLinkId": {
      "type": "string",
      "format": "uuid"
    },
    "creator": {
      "$ref": "urn:aab:scs:schema:platform:actor-subject-link-actor:1"
    }
  }
}
