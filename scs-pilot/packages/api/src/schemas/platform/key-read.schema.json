{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aab:schema:platform:key-read:1",
  "title": "KeyRead",
  "description": "GET /aab/v1/signing-keys/:keyId (200): a key as registered, with its events and compromises, and its state derived now (AAB-PLATFORM-09 sections 4 and 8). Nothing is stored about its state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registration",
    "events",
    "compromises",
    "currentState",
    "readAt"
  ],
  "properties": {
    "registration": {
      "$ref": "urn:aab:schema:platform:key-registration-view:1"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventType",
          "effectiveAt",
          "recordedAt"
        ],
        "properties": {
          "eventType": {
            "type": "string",
            "enum": [
              "SUSPENDED",
              "REINSTATED",
              "RETIRED"
            ]
          },
          "effectiveAt": {
            "type": "string",
            "format": "date-time"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "compromises": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "suspectedExposureFrom",
          "recordedAt"
        ],
        "properties": {
          "suspectedExposureFrom": {
            "type": "string",
            "format": "date-time"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "currentState": {
      "type": "string",
      "enum": [
        "PENDING",
        "ACTIVE",
        "SUSPENDED",
        "RETIRED",
        "COMPROMISED"
      ]
    },
    "retiredAt": {
      "type": "string",
      "format": "date-time"
    },
    "exposureWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "until"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "until": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "readAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
