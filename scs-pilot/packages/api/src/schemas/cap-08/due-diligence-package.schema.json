        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "eventVersion": {
            "type": "integer",
            "minimum": 1
          },
          "eventType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "batchIdentifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "commodityCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "sourcePartyId": {
            "type": "string",
            "format": "uuid"
          },
          "destinationPartyId": {
            "type": "string",
            "format": "uuid"
          },
          "eventDate": {
            "type": "string",
            "format": "date"
          },
          "timePrecision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "quantity": {
            "title": "ScsPackageCustodyQuantity",
            "type": "object",
