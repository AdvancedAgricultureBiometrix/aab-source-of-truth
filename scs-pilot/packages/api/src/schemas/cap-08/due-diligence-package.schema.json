    "sufficiencyEvaluation": {
      "title": "ScsPackageSufficiencyEvaluation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluationId",
        "evaluationSnapshotDigest",
        "evaluationReceiptDigest",
        "result"
      ],
      "properties": {
        "evaluationId": {
          "type": "string",
          "format": "uuid"
        },
        "evaluationSnapshotDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evaluationReceiptDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "result": {
          "$ref": "urn:aab:scs:schema:cap-06:sufficiency-evaluation-result:1"
        }
      }
    },
    "reviewDecision": {
      "title": "ScsPackageReviewDecision",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId",
        "decision",
        "decisionReceiptDigest",
        "currencyStatusAtCompilation",
        "recordValidityAtCompilation"
      ],
      "properties": {
        "decisionId": {
          "type": "string",
          "format": "uuid"
        },
        "decision": {
          "$ref": "urn:aab:scs:schema:cap-09:recorded-decision:1"
        },
        "decisionReceiptDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "currencyStatusAtCompilation": {
          "type": "string",
          "const": "CURRENT"
        },
        "recordValidityAtCompilation": {
          "type": "string",
          "const": "VALID"
        }
      }
    },
    "gapDisclosure": {
      "title": "ScsPackageGapDisclosure",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalGapsIdentified",
        "blockingGaps",
        "nonBlockingGaps",
        "gapDisclosureStatement"
      ],
      "properties": {
        "totalGapsIdentified": {
          "type": "integer",
          "minimum": 0
        },
        "blockingGaps": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "title": "ScsPackageBlockingGap",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gapId",
              "requirementCode",
              "gapType",
              "explanation",
              "humanDecisionMade",
              "reviewerAssessment"
            ],
            "properties": {
              "gapId": {
                "type": "string",
                "format": "uuid"
              },
              "requirementCode": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "\\S"
              },
              "gapType": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "\\S"
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "humanDecisionMade": {
                "type": "boolean"
              },
              "humanDecisionId": {
                "type": "string",
                "format": "uuid"
              },
              "reviewerAssessment": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              }
            }
          }
        },
        "nonBlockingGaps": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "title": "ScsPackageNonBlockingGap",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gapId",
              "requirementCode",
              "gapType",
              "explanation",
              "reviewerAssessment"
            ],
            "properties": {
              "gapId": {
                "type": "string",
                "format": "uuid"
              },
              "requirementCode": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "\\S"
              },
              "gapType": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "\\S"
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "reviewerAssessment": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              }
            }
          }
        },
        "gapDisclosureStatement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        }
      }
    },
    "packageLimitations": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      }
    },
    "authorityBoundary": {
      "title": "ScsPackageAuthorityBoundary",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiledNotSubmitted",
        "operatorMustMakeDeclaration",
        "noComplianceDetermination",
        "doesNotGuaranteeRegulatoryAcceptance",
        "legalResponsibilityRemainsWithOperator",
        "sufficientEvidenceDoesNotMeanLegallyCompliant",
        "gapsDisclosedNotResolved"
      ],
      "properties": {
        "compiledNotSubmitted": {
          "type": "boolean",
          "const": true
        },
        "operatorMustMakeDeclaration": {
          "type": "boolean",
          "const": true
        },
        "noComplianceDetermination": {
          "type": "boolean",
          "const": true
        },
        "doesNotGuaranteeRegulatoryAcceptance": {
          "type": "boolean",
          "const": true
        },
        "legalResponsibilityRemainsWithOperator": {
          "type": "boolean",
          "const": true
        },
        "sufficientEvidenceDoesNotMeanLegallyCompliant": {
          "type": "boolean",
          "const": true
        },
        "gapsDisclosedNotResolved": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "challengeResponseMetadata": {
      "title": "ScsPackageChallengeResponseMetadata",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allEvidenceIds",
        "allProvenanceChains",
        "retrievableViaCapability"
      ],
      "properties": {
        "allEvidenceIds": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "allProvenanceChains": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "title": "ScsPackageProvenanceChain",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidenceId",
              "evidenceKind",
              "admissionReceiptId",
              "contentDigest",
              "fileSha256Verified"
            ],
            "properties": {
              "evidenceId": {
                "type": "string",
                "format": "uuid"
              },
              "evidenceKind": {
                "type": "string",
                "enum": [
                  "DEFORESTATION",
                  "CUSTODY"
                ]
              },
              "admissionReceiptId": {
                "type": "string",
                "format": "uuid"
              },
              "contentDigest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "fileSha256Verified": {
                "type": "boolean"
              }
            }
          }
        },
        "retrievableViaCapability": {
          "type": "string",
          "const": "SCS-CAP-10"
        }
      }
    }
  }
}
