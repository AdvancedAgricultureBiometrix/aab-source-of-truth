            "required": [
              "amount",
              "unit",
              "measurementMethod"
            ],
            "properties": {
              "amount": {
                "type": "number"
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "\\S"
              },
              "measurementMethod": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "\\S"
              }
            }
          },
          "supportingDocument": {
            "title": "ScsPackageSupportingDocument",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "documentType",
              "documentReference",
              "contentDigest"
            ],
            "properties": {
              "documentType": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "\\S"
              },
              "documentReference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "\\S"
              },
              "contentDigest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "provenance": {
            "title": "ScsPackageCustodyProvenance",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "submittedBy",
              "submittedAt",
              "integrityStatus",
              "chainOfCustodyComplete"
            ],
            "properties": {
              "submittedBy": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "\\S"
              },
              "submittedAt": {
                "type": "string",
                "format": "date-time"
              },
              "integrityStatus": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "\\S"
              },
              "chainOfCustodyComplete": {
                "type": "boolean"
              }
            }
          },
          "sourcePlotIds": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "links": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "title": "ScsPackageCustodyLink",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "linkType",
                "citedEventId"
