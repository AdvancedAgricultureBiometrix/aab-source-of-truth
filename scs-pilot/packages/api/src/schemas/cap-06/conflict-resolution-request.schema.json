{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aab:scs:schema:cap-06:conflict-resolution-request:1",
  "title": "ScsConflictResolutionSubmission",
  "description": "SCS-CAP-06 ScsConflictResolutionSubmission (contract e0b7634). The system sets resolutionId, reviewer (the submitting actor) and resolvedAt. Every field but inapplicableEvidenceId is required here; the cross-field checks are the capability's (RESOLUTION_INCOMPLETE).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conflictKey",
    "evaluationId",
    "comparedEvidenceIds",
    "provenanceAndMethodsConsidered",
    "resolutionReason",
    "additionalEvidenceObtained",
    "additionalEvidenceIds",
    "remainingLimitations",
    "authorityBasis",
    "reEvaluationRequired"
  ],
  "properties": {
    "conflictKey": {
      "description": "requirementCode:evidenceAId:evidenceBId, the ids in sorted order.",
      "type": "string",
      "pattern": "^[A-Z]+(-[A-Z]+)+:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "evaluationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "comparedEvidenceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    },
    "provenanceAndMethodsConsidered": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S"
    },
    "resolutionReason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S"
    },
    "inapplicableEvidenceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "additionalEvidenceObtained": {
      "type": "boolean"
    },
    "additionalEvidenceIds": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    },
    "remainingLimitations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000,
        "pattern": "\\S"
      }
    },
    "authorityBasis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "reEvaluationRequired": {
      "type": "boolean"
    }
  }
}
