{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aab:scs:schema:cap-06:conflict-resolution-response:1",
  "title": "ScsConflictResolutionResponse",
  "description": "Body of a successful POST /scs/v1/conflict-resolutions (201): the resolution record (as decision), the immutable receipt that records it, and the receipt's SHA-256 over canonical JSON.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "receipt",
    "receiptDigest"
  ],
  "properties": {
    "decision": {
      "$ref": "urn:aab:scs:schema:cap-06:conflict-resolution-record:1"
    },
    "receipt": {
      "$ref": "urn:aab:scs:schema:cap-06:conflict-resolution-receipt:1"
    },
    "receiptDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
